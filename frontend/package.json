{
  "name": "tacet-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "typecheck": "tsc",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "walkthrough": "node scripts/walkthrough.mjs",
    "compare": "node scripts/compare.mjs"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.2.2",
    "vite": "^8.2.4",
    "vitest": "^3.2.7"
  }
}
