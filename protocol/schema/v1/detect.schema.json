{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jorben/tacet/protocol/schema/v1/detect.schema.json",
  "title": "detect.run: model detection of one text unit",
  "$defs": {
    "Params": {
      "allOf": [{"$ref": "lifecycle.schema.json#/$defs/Task"}],
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "maxLength": 1048576}
      },
      "unevaluatedProperties": false
    },
    "Span": {
      "type": "object",
      "required": ["label", "start", "end", "score"],
      "properties": {
        "label": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
        "start": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "end": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "score": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "Spans": {
      "type": "object",
      "required": ["kind", "spans"],
      "properties": {
        "kind": {"const": "spans"},
        "spans": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/Span"}}
      },
      "additionalProperties": false
    },
    "UnitDone": {
      "type": "object",
      "required": ["kind", "spans"],
      "properties": {
        "kind": {"const": "unit_done"},
        "spans": {"type": "integer", "minimum": 0, "maximum": 1048576}
      },
      "additionalProperties": false
    },
    "Item": {
      "oneOf": [{"$ref": "#/$defs/Spans"}, {"$ref": "#/$defs/UnitDone"}]
    }
  }
}
