{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jorben/tacet/protocol/schema/v1/rpc.schema.json",
  "title": "JSON-RPC 2.0 envelope; role parameters validated separately",
  "$defs": {
    "ID": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "string", "minLength": 1, "maxLength": 128}
      ]
    },
    "Request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/ID"},
        "method": {"type": "string", "minLength": 1, "maxLength": 128},
        "params": {"type": "object"}
      },
      "additionalProperties": false
    },
    "Notification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "method": {"type": "string", "minLength": 1, "maxLength": 128},
        "params": {"type": "object"}
      },
      "additionalProperties": false
    },
    "Success": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/ID"},
        "result": {"type": "object"}
      },
      "additionalProperties": false
    },
    "Failure": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/ID"},
        "error": {
          "type": "object",
          "required": ["code", "message", "data"],
          "properties": {
            "code": {"type": "integer"},
            "message": {"const": "Plugin request failed"},
            "data": {"$ref": "common.schema.json#/$defs/Error"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Message": {
      "oneOf": [
        {"$ref": "#/$defs/Request"},
        {"$ref": "#/$defs/Notification"},
        {"$ref": "#/$defs/Success"},
        {"$ref": "#/$defs/Failure"}
      ]
    }
  }
}
