<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="tacet"
        Arguments=""
        InstallLocation="C:\Program Files\Tacet\Tacet">
    </Installer>
    <PackageInformation
        PackageName="Tacet"
        PackageDisplayName="Tacet"
        PublisherName="CN=Tacet"
        PublisherDisplayName="Tacet"
        Version="0.1.0.0"
        PackageDescription="Local document redaction">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.jorben.tacet"
                Description="Local document redaction"
                DisplayName="Tacet"
                ExecutableName="tacet"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Tacet</DisplayName>
            <PublisherDisplayName>Tacet</PublisherDisplayName>
            <Description>Local document redaction</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="tacet.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
