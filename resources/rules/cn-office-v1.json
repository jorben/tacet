{
  "id": "cn-office-v1",
  "description": "Built-in rules for Chinese office documents (phone, e-mail, resident ID, bank card, IPv4, URL, well-known credential formats). Bank cards: 16 or 19 digits only; 17/18-digit numbers are left to the model and review. Labelled staff ids and person-related dates use context keywords within a short window on the same line.",
  "rules": [
    {
      "id": "cn_mobile",
      "category": "phone",
      "pattern": "(?:\\+?86[- ]?)?1[3-9][0-9][- ]?[0-9]{4}[- ]?[0-9]{4}",
      "boundary": "digit"
    },
    {
      "id": "cn_landline",
      "category": "phone",
      "pattern": "(?:\\+?86[- ]?)?0[1-9][0-9]{1,2}[- ][0-9]{7,8}(?:[- ][0-9]{1,6})?",
      "boundary": "digit"
    },
    {
      "id": "email",
      "category": "email",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+"
    },
    {
      "id": "cn_resident_id",
      "category": "id_number",
      "pattern": "[1-9][0-9]{5}(?:19|20)[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx]",
      "boundary": "digit",
      "validator": "cn_id",
      "suspect": true
    },
    {
      "id": "bank_card_plain",
      "category": "payment_card",
      "pattern": "[0-9]{16}|[0-9]{19}",
      "boundary": "digit",
      "validator": "luhn",
      "suspect": true
    },
    {
      "id": "bank_card_grouped",
      "category": "payment_card",
      "pattern": "[0-9]{4}(?:[- ][0-9]{4}){3}(?:[- ][0-9]{3})?",
      "boundary": "digit",
      "validator": "luhn",
      "suspect": true
    },
    {
      "id": "ipv4",
      "category": "ip_address",
      "pattern": "(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])",
      "boundary": "digit"
    },
    {
      "id": "url",
      "category": "url",
      "pattern": "https?://[A-Za-z0-9._~:/?#@!$&*+,;=%-]*[A-Za-z0-9/_~%=#-]"
    },
    {
      "id": "secret_openai_style",
      "category": "secret",
      "pattern": "sk-[A-Za-z0-9_-]{20,}"
    },
    {
      "id": "secret_aws_access_key",
      "category": "secret",
      "pattern": "(?:AKIA|ASIA)[0-9A-Z]{16}",
      "boundary": "word"
    },
    {
      "id": "secret_github_token",
      "category": "secret",
      "pattern": "gh[pousr]_[A-Za-z0-9]{36,}"
    },
    {
      "id": "secret_jwt",
      "category": "secret",
      "pattern": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"
    },
    {
      "id": "secret_private_key_block",
      "category": "secret",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----"
    },
    {
      "id": "staff_id_labelled",
      "category": "account",
      "pattern": "E[0-9]{6,10}",
      "boundary": "digit",
      "context": [
        "工号",
        "员工号",
        "员工编号",
        "staff id",
        "employee id"
      ],
      "context_window": 8
    },
    {
      "id": "person_date_cn",
      "category": "date",
      "pattern": "(?:19|20)[0-9]{2}年[0-9]{1,2}月[0-9]{1,2}日",
      "boundary": "digit",
      "context": [
        "出生",
        "生日",
        "有效期",
        "就诊",
        "身份证"
      ],
      "context_window": 12
    },
    {
      "id": "person_date_iso",
      "category": "date",
      "pattern": "(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])",
      "boundary": "digit",
      "context": [
        "出生",
        "生日",
        "有效期",
        "就诊",
        "身份证"
      ],
      "context_window": 12
    }
  ]
}
